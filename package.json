{
  "name": "word-template-filler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/main/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test test/ocr-two-stage.test.cjs test/ocr-two-stage-lines.test.cjs test/ocr-training.test.cjs",
    "test:integration": "node --test test/integration/two-stage-real-pdf.test.cjs test/integration/layout-join-lines-real.test.cjs",
    "electron": "electron .",
    "dev:electron": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "build": "vite build",
    "build:exe": "npm run build && electron-builder --win nsis",
    "build:exe:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-exe.ps1"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "onnxruntime-node": "^1.30.0",
    "pdfjs-dist": "^3.11.174",
    "ppu-doclayout": "^1.0.0",
    "ppu-paddle-ocr": "^6.6.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "concurrently": "^9.2.4",
    "docx-preview": "^0.4.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "js-levenshtein": "^1.1.6",
    "jszip": "^3.10.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.wordtemplatefiller.app",
    "productName": "Word Template Filler",
    "icon": "src/main/assets/icon-folder-pink.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "src/main/db/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/ppu-paddle-ocr/**",
      "node_modules/ppu-doclayout/**",
      "node_modules/ppu-ocv/**",
      "node_modules/@napi-rs/canvas/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Word Template Filler"
    }
  }
}
